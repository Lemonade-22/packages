msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: en\n"

msgid "（来自接口配置）"
msgstr "(from interface config)"

msgid "/etc/config/network 中未找到 LAN 接口"
msgstr "LAN interface not found in /etc/config/network"

msgid "1 小时"
msgstr "1 hour"

msgid "12 小时"
msgstr "12 hours"

msgid "24 小时"
msgstr "24 hours"

msgid "30 分钟"
msgstr "30 minutes"

msgid "5 分钟"
msgstr "5 minutes"

msgid "7 天"
msgstr "7 days"

msgid "必须填写固定 IPv4 地址"
msgstr "Fixed IPv4 address is required"

msgid "必须填写主机名或 MAC 地址"
msgstr "Hostname or MAC address is required"

msgid "编辑静态绑定"
msgstr "Edit static binding"

msgid "编辑已禁用："
msgstr "Editing disabled: "

msgid "不能绑定路由器自身地址"
msgstr "Cannot bind the router address itself"

msgid "不能使用网络地址或广播地址"
msgstr "Cannot use network or broadcast address"

msgid "操作"
msgstr "Action"

msgid "当前持有 DHCP 租约的设备。点击“设为静态”会暂存该地址的固定绑定，再点“保存并应用”生效。"
msgstr "Devices that currently hold a DHCP lease. “Make static” stages a fixed binding for the leased address; commit it with “Save & Apply”."

msgid "当前没有活动的 DHCP 租约。"
msgstr "No active DHCP leases."

msgid "地址不在 LAN 子网内"
msgstr "Address is outside the LAN subnet"

msgid "地址当前已被另一台设备租用"
msgstr "Address currently leased to another device"

msgid "该客户端使用的 DNS 服务器 IPv4 地址。留空则使用上方的网关地址。"
msgstr "IPv4 address of the DNS server for this client. Leave empty to use the gateway address above."

msgid "该设备已有静态绑定。"
msgstr "This device already has a static binding."

msgid "该租约没有可用的 MAC 地址。"
msgstr "This lease has no usable MAC address."

msgid "固定 IPv4"
msgstr "Fixed IPv4"

msgid "继承地址池"
msgstr "Inherit from pool"

msgid "继承系统"
msgstr "Inherit system"

msgid "继承系统（留空）"
msgstr "Inherit system (leave empty)"

msgid "检测到多个 dnsmasq 实例"
msgstr "Multiple dnsmasq instances detected"

msgid "将固定 IPv4 地址绑定到 MAC，并可为指定客户端下发自定义网关（DHCP option 3）和 DNS（option 6）。"
msgstr "Bind fixed IPv4 addresses to MAC and optionally override gateway (option 3) and DNS (option 6) for individual clients."

msgid "仅为该客户端下发 DNS 服务器（DHCP option 6）。"
msgstr "Send a DNS server (DHCP option 6) to this client only."

msgid "静态"
msgstr "Static"

msgid "静态绑定"
msgstr "Static Bindings"

msgid "静态地址绑定"
msgstr "Static Address Binding"

msgid "可选。仅为该客户端覆盖 IPv4 网关（DHCP option 3）。留空则继承系统网关。"
msgstr "Optional. Overrides the IPv4 gateway (DHCP option 3) for this client. Leave empty to inherit the system gateway."

msgid "默认网关："
msgstr "Default gateway: "

msgid "设为静态"
msgstr "Make static"

msgid "提示："
msgstr "Notice: "

msgid "网关"
msgstr "Gateway"

msgid "网关必须在 LAN 子网内"
msgstr "Gateway must be inside the LAN subnet"

msgid "网关不能是网络地址或广播地址"
msgstr "Gateway cannot be network or broadcast address"

msgid "网关不能与固定 IP 相同"
msgstr "Gateway cannot be the same as the fixed IP"

msgid "未检测到，沿用接口配置"
msgstr "not detected - inheriting interface configuration"

msgid "未能识别 LAN 的 DHCP 地址池配置，因此地址池范围未知。仍可正常创建和编辑绑定。"
msgstr "No DHCP pool section for LAN could be identified, so the pool range is unknown. Bindings can still be created and edited."

msgid "无法确定 LAN 子网"
msgstr "Cannot determine LAN subnet"

msgid "无效的 IPv4 地址"
msgstr "Invalid IPv4 address"

msgid "无效的 MAC 地址"
msgstr "Invalid MAC address"

msgid "系统默认（未确定）"
msgstr "System default (undetermined)"

msgid "需要有效的 MAC 地址"
msgstr "Expecting a valid MAC address"

msgid "已暂存"
msgstr "Staged"

msgid "已暂存 %s 的静态绑定。请点击“保存并应用”提交。"
msgstr "Staged a static binding for %s. Click “Save & Apply” to commit."

msgid "永久"
msgstr "Infinite"


msgid "由其他规则决定"
msgstr "Decided by other rules"

msgid "与网关相同"
msgstr "same as gateway"

msgid "在线设备"
msgstr "Online devices"

msgid "只读（请在官方 DHCP 页面管理）"
msgstr "Read-only (manage in official DHCP page)"

msgid "主机名"
msgstr "Hostname"

msgid "状态"
msgstr "Status"

msgid "自定义 DNS"
msgstr "Custom DNS"

msgid "租期"
msgstr "Lease time"

msgid "租期格式无效（例如 12h、7d）"
msgstr "Invalid lease time format (e.g. 12h, 7d)"

msgid "租约到期"
msgstr "Lease expires"

msgid "DHCP 地址池："
msgstr "DHCP pool: "

msgid "DNS 服务器"
msgstr "DNS server"

msgid "IPv4 地址"
msgstr "IPv4 address"

msgid "IPv4 已被其他绑定使用"
msgstr "IPv4 already used by another binding"

msgid "LAN 接口未配置为静态 IPv4"
msgstr "LAN interface is not configured as static IPv4"

msgid "LAN 没有活动的 DHCPv4 配置"
msgstr "No active DHCPv4 configuration for LAN"

msgid "LAN 未配置 IPv4 地址"
msgstr "LAN has no IPv4 address configured"

msgid "LAN："
msgstr "LAN: "

msgid "MAC 必须是有效的单播地址"
msgstr "MAC must be a valid unicast address"

msgid "MAC 地址"
msgstr "MAC Address"

msgid "MAC 地址已被其他绑定使用"
msgstr "MAC address already used by another binding"


msgid "（未保存）"
msgstr "(unsaved)"
