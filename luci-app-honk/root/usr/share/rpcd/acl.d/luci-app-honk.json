{
	"luci-app-honk": {
		"description": "Grant access to honk configuration",
		"read": {
			"file": {
				"/etc/honk/config.dae": [
					"read"
				],
				"/etc/honk/custom.rules": [
					"read"
				],
				"/etc/honk/adblock.list": [
					"read"
				],
				"/var/log/honk.log": [
					"read"
				],
				"/usr/share/honk/gen_dae.sh": [
					"exec"
				],
				"/usr/share/honk/probe.sh": [
					"exec"
				],
				"/usr/share/honk/update-adblock.sh": [
					"exec"
				],
				"/usr/share/honk/update-subs.sh": [
					"exec"
				],
				"/usr/share/honk/update-geo.sh": [
					"exec"
				],
				"/etc/init.d/honk": [
					"exec"
				],
				"/usr/share/honk/honk-api.sh": [
					"exec"
				],
				"/usr/share/honk/honk-status.sh": [
					"exec"
				],
				"/usr/share/honk/dash-status.sh": [
					"exec"
				]
			},
			"ubus": {
				"service": [
					"list"
				]
			},
			"uci": [
				"honk",
				"network"
			]
		},
		"write": {
			"file": {
				"/etc/honk/config.dae": [
					"write"
				],
				"/etc/honk/custom.rules": [
					"write"
				],
				"/etc/honk/adblock.list": [
					"write"
				]
			},
			"uci": [
				"honk"
			]
		}
	}
}
