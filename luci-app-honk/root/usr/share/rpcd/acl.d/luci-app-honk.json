{
	"luci-app-honk": {
		"description": "Grant access to honk configuration",
		"read": {
			"file": {
				"/etc/honk/config.dae": [
					"read"
				],
				"/etc/honk/custom.rules": [
					"read"
				],
				"/etc/honk/adblock.list": [
					"read"
				],
				"/var/log/honk.log": [
					"read"
				],
				"/usr/share/honk/honk-status.sh": [
					"exec"
				],
				"/usr/share/honk/dash-status.sh": [
					"exec"
				],
				"/usr/share/honk/honk-read.sh": [
					"exec"
				],
				"/usr/share/honk/log-tail.sh": [
					"exec"
				],
				"/var/run/honk/apply.json": [
					"read"
				],
				"/var/run/honk/validation.json": [
					"read"
				],
				"/usr/share/honk/geo/*": [
					"stat"
				]
			},
			"ubus": {
				"service": [
					"list"
				],
				"luci.honk": [
					"connection_check"
				],
				"network.device": [
					"status"
				]
			},
			"uci": [
				"honk",
				"network",
				"wireless"
			]
		},
		"write": {
			"file": {
				"/etc/honk/config.dae": [
					"write"
				],
				"/etc/honk/custom.rules": [
					"write"
				],
				"/etc/honk/adblock.list": [
					"write"
				],
				"/usr/share/honk/update-adblock.sh": [
					"exec"
				],
				"/usr/share/honk/update-geo.sh": [
					"exec"
				],
				"/usr/share/honk/honk-api.sh": [
					"exec"
				],
				"/etc/init.d/honk": [
					"exec"
				]
			},
			"uci": [
				"honk"
			]
		}
	}
}
