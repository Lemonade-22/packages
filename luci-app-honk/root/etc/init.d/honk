#!/bin/sh /etc/rc.common
#
# luci-app-honk 的启动脚本。
#
# 生成 .dae -> 挂 bpffs -> 建 700 权限的 state 目录 -> procd 拉起 honk-core。

USE_PROCD=1
START=99
STOP=15

HONK_CONF="/etc/honk/config.dae"
GEN_SCRIPT="/usr/share/honk/gen_dae.sh"

honk_bin() {
	for b in /usr/sbin/honk-core /usr/bin/honk-core /sbin/honk-core /bin/honk-core; do
		[ -x "$b" ] && { echo "$b"; return 0; }
	done
	return 1
}

is_enabled() {
	[ "$(uci -q get honk.config.enabled)" = "1" ]
}

is_running() {
	ubus call service list '{"name":"honk"}' 2>/dev/null | grep -q '"running": true'
}

data_dir() {
	local d
	d="$(uci -q get honk.infra.data_dir)"
	[ -n "$d" ] || d="/var/lib/honk"
	echo "$d"
}

geo_dir() {
	local d
	d="$(uci -q get honk.infra.geo_asset_dir)"
	[ -n "$d" ] || d="/usr/share/honk/geo"
	echo "$d"
}

prepare_data_dir() {
	local d
	d="$(data_dir)"
	mkdir -p /etc/honk 2>/dev/null
	mkdir -p "$d/state"
	# honk 会拒绝 group/other 可写的 state 目录，直接拒绝启动
	chmod 700 "$d" "$d/state" 2>/dev/null
}

mount_bpffs() {
	[ -d /sys/fs/bpf ] || mkdir -p /sys/fs/bpf
	mountpoint -q /sys/fs/bpf 2>/dev/null && return 0
	mount -t bpf bpf /sys/fs/bpf 2>/dev/null
}

check_geo() {
	local g
	g="$(geo_dir)"
	for f in geoip.dat geosite.dat; do
		if [ ! -s "$g/$f" ]; then
			# honk 只会警告不会报错，规则静默失效，这里主动吼一声
			echo "honk: warning: $g/$f missing, geosite/geoip matchers will be inactive"
		fi
	done
}

generate() {
	if ! sh "$GEN_SCRIPT" "$HONK_CONF"; then
		echo "honk: failed to generate $HONK_CONF"
		return 1
	fi
	if [ ! -s "$HONK_CONF" ]; then
		echo "honk: $HONK_CONF is empty, refusing to start"
		return 1
	fi
}

start_service() {
	is_enabled || return 0

	local bin
	bin="$(honk_bin)" || {
		echo "honk: honk-core not found in PATH candidates"
		return 1
	}

	prepare_data_dir
	mount_bpffs
	check_geo
	generate || return 1

	mkdir -p /var/log 2>/dev/null

	procd_open_instance
	# procd 的 logfile 参数在这台固件上不创建文件，所以用 sh -c 'exec ...'
	# 自己重定向：exec 会让 honk-core 顶替 sh，procd 跟踪的 pid 仍然是它，
	# 停止和 respawn 都正常。
	procd_set_param command /bin/sh -c 		"exec $bin -c '$HONK_CONF' --data-dir '$(data_dir)' --disable-timestamp >>/var/log/honk.log 2>&1"
	procd_set_param env DAE_LOCATION_ASSET="$(geo_dir)"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_set_param limits core="unlimited"
	procd_close_instance
}

stop_service() {
	# procd 负责发信号；这里只清掉可能残留的 pinned map
	return 0
}

reload_service() {
	# 关掉开关不能只是"什么都不做"：已经在跑的实例得停掉，
	# 开机自启的软链也得摘掉，否则关了开关重启它照样起来。
	if ! is_enabled; then
		stop
		disable
		return 0
	fi

	# 开着的状态下补回自启软链，避免之前 disable 过之后再也起不来
	enable

	generate || return 1
	local bin
	bin="$(honk_bin)" || return 1

	# 没在跑就直接启动。之前这里无条件发 SIGHUP，而 SIGHUP 只对运行中的
	# 实例有意义——从 LuCI 点"启用"保存触发的是 reload，于是永远起不来。
	if ! is_running; then
		start
		return $?
	fi

	# honk 读 /run/honk-core.lock 发 SIGHUP，运行实例自己决定 apply 还是 reject
	"$bin" reload
}

service_triggers() {
	procd_add_reload_trigger "honk"
}